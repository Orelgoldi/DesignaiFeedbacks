# Email שממנו יישלחו ההתראות (חשבון Gmail שלך)
EMAIL_USER=your-gmail@gmail.com

# App Password של Gmail (לא הסיסמה הרגילה - ראה הוראות למטה)
# 1. היכנס ל-myaccount.google.com
# 2. אבטחה -> אימות דו-שלבי (חייב להיות מופעל)
# 3. חיפוש "סיסמאות לאפליקציות"
# 4. צור סיסמה חדשה -> העתק כאן
EMAIL_PASS=your-gmail-app-password

# מייל הניהול שיקבל התראות (ניתן לשנות)
ADMIN_EMAIL=info.aidesign1@gmail.com

# סיסמת כניסה לפאנל הניהול
ADMIN_PASSWORD=DesignAI2024

# פורט השרת (ברירת מחדל: 3000)
PORT=3000
